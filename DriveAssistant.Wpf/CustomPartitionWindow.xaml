<Window x:Class="FATXTools.Wpf.CustomPartitionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Custom Partition"
        Width="520"
        Height="310"
        MinWidth="500"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBgBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Border Padding="20" Background="{DynamicResource AppBgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Add custom FATX partition" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Offsets and lengths accept decimal or hex values such as 0x120000."
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="2"
                    Background="{DynamicResource PanelBgBrush}"
                    BorderBrush="{DynamicResource LineSoftBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Name" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    <TextBox x:Name="NameTextBox" Grid.Column="1" Text="CustomPartition" />

                    <TextBlock Grid.Row="2" Text="Offset" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    <TextBox x:Name="OffsetTextBox" Grid.Row="2" Grid.Column="1" Text="0x0" />

                    <TextBlock Grid.Row="4" Text="Length" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    <TextBox x:Name="LengthTextBox" Grid.Row="4" Grid.Column="1" Text="0x0" />
                </Grid>
            </Border>

            <TextBlock x:Name="StatusTextBlock"
                       Grid.Row="3"
                       Foreground="{DynamicResource MutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0" />

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Width="92" Click="Cancel_Click" />
                <Button Content="Add" Width="92" Margin="10,0,0,0" Style="{StaticResource PrimaryButton}" Click="Add_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
