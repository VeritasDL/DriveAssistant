<Window x:Class="FATXTools.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Drive Assistant" Height="860" Width="1320"
        MinHeight="680" MinWidth="900"
        Icon="appicon.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        StateChanged="Window_StateChanged"
        PreviewMouseDown="Window_PreviewMouseDown"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Closing="Window_Closing"
        WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="30"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid x:Name="RootShell">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{DynamicResource RootGradientStart}" Offset="0" />
                <GradientStop Color="{DynamicResource RootGradientMid}" Offset="0.48" />
                <GradientStop Color="{DynamicResource RootGradientEnd}" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource TitleBarBgBrush}"
                BorderBrush="{DynamicResource LineSoftBrush}"
                BorderThickness="0,0,0,1"
                Height="30"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Image Source="appicon.ico" Width="16" Height="16" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{DynamicResource TitleBarTextBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="&#xE921;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Foreground="{DynamicResource TitleBarTextBrush}"
                        MinWidth="46"
                        MinHeight="30"
                        Padding="0"
                        BorderThickness="0"
                        ToolTip="Minimize"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MinimizeWindow_Click" />
                <Button Grid.Column="2"
                        Content="&#xE922;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Foreground="{DynamicResource TitleBarTextBrush}"
                        MinWidth="46"
                        MinHeight="30"
                        Padding="0"
                        BorderThickness="0"
                        ToolTip="Maximize"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MaximizeRestoreWindow_Click" />
                <Button Grid.Column="3"
                        Content="&#xE8BB;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Foreground="{DynamicResource TitleBarTextBrush}"
                        MinWidth="46"
                        MinHeight="30"
                        Padding="0"
                        BorderThickness="0"
                        ToolTip="Close"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CloseWindow_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource ToolbarBgBrush}"
                BorderBrush="{DynamicResource LineSoftBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" MinWidth="240" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button Content="File" Height="30" MinHeight="30" MinWidth="54" Padding="12,0" Click="MenuButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="OpenImageMenuItem" Header="Open Image..." Click="OpenImage_Click" />
                                <MenuItem x:Name="LoadDatabaseMenuItem" Header="Load Database..." Click="LoadDatabase_Click" IsEnabled="{Binding HasOpenDatabase}" />
                                <MenuItem x:Name="SaveDatabaseMenuItem" Header="Save Database..." Click="SaveDatabase_Click" IsEnabled="{Binding HasOpenDatabase}" />
                                <Separator />
                                <MenuItem x:Name="SaveSelectedMenuItem" Header="Save Selected..." Click="SaveSelected_Click" IsEnabled="{Binding HasSelection}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="Analysis" Height="30" MinHeight="30" MinWidth="76" Padding="12,0" Margin="4,0,0,0" Click="MenuButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="MetadataScanMenuItem" Header="Metadata Scan" Click="MetadataScan_Click" IsEnabled="{Binding CanRunMetadataScan}" />
                                <MenuItem x:Name="FileCarverMenuItem" Header="File Carver" Click="FileCarver_Click" IsEnabled="{Binding CanRunFileCarver}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="View" Height="30" MinHeight="30" MinWidth="54" Padding="12,0" Margin="4,0,0,0" Click="MenuButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="SearchMenuItem" Header="Search Results" Click="SearchShortcut_Click" />
                                <Separator />
                                <MenuItem x:Name="TogglePartitionsMenuItem" Header="Show / Hide Partitions" Click="TogglePartitionsShortcut_Click" />
                                <MenuItem x:Name="ToggleInspectorMenuItem" Header="Show / Hide Inspector" Click="ToggleInspectorShortcut_Click" />
                                <MenuItem x:Name="ToggleClusterViewerMenuItem" Header="Toggle Cluster Viewer" Click="ToggleClusterViewer_Click" />
                                <MenuItem x:Name="ToggleResultsWindowMenuItem" Header="Pop Out / Dock Results" Click="ToggleResultsWindow_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="Tools" Height="30" MinHeight="30" MinWidth="58" Padding="12,0" Margin="4,0,0,0" Click="MenuButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="AddPartitionMenuItem" Header="Add Custom Partition..." Click="AddCustomPartition_Click" IsEnabled="{Binding CanAddCustomPartition}" />
                                <MenuItem x:Name="UnmountPartitionMenuItem" Header="Unmount Partition" Click="UnmountPartition_Click" IsEnabled="{Binding CanUnmountPartition}" />
                                <Separator />
                                <MenuItem x:Name="SettingsMenuItem" Header="Settings..." Click="Settings_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="Help" Height="30" MinHeight="30" MinWidth="54" Padding="12,0" Margin="4,0,0,0" Click="MenuButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="AboutMenuItem" Header="About Drive Assistant" Click="About_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}" Width="34" MinWidth="34" Height="30" MinHeight="30" Padding="0" Click="OpenImage_Click">
                        <Button.ToolTip>
                            <ToolTip MaxWidth="380">
                                <StackPanel>
                                    <TextBlock Text="Open Image" FontWeight="SemiBold" />
                                    <TextBlock Text="Open a console drive image or compressed HDD image." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8E5;" Margin="0" />
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Width="34" MinWidth="34" Height="30" MinHeight="30" Padding="0" Margin="6,0,0,0" ToolTipService.ShowOnDisabled="True" Click="MetadataScan_Click" IsEnabled="{Binding CanRunMetadataScan}">
                        <Button.ToolTip>
                            <ToolTip MaxWidth="380">
                                <StackPanel>
                                    <TextBlock Text="Metadata Scan" FontWeight="SemiBold" />
                                    <TextBlock Text="Scan the selected partition for deleted or recoverable filesystem metadata." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE9D2;" Margin="0" />
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Width="34" MinWidth="34" Height="30" MinHeight="30" Padding="0" Margin="6,0,0,0" ToolTipService.ShowOnDisabled="True" Click="FileCarver_Click" IsEnabled="{Binding CanRunFileCarver}">
                        <Button.ToolTip>
                            <ToolTip MaxWidth="380">
                                <StackPanel>
                                    <TextBlock Text="File Carver" FontWeight="SemiBold" />
                                    <TextBlock Text="Scan the selected partition for recoverable file signatures." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" Margin="0" />
                    </Button>
                    <Separator Width="1" Margin="10,4" Background="{DynamicResource LineSoftBrush}" />
                    <ComboBox x:Name="RecentImagesCombo"
                              Width="170"
                              MinHeight="30"
                              Margin="0"
                              ItemsSource="{Binding RecentImages}"
                              SelectionChanged="RecentImagesCombo_SelectionChanged"
                              ToolTip="Open a recently selected HDD image">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="ShowPartitionsButton"
                            Style="{StaticResource SecondaryButton}"
                            Width="34"
                            MinWidth="34"
                            Height="30"
                            MinHeight="30"
                            Padding="0"
                            Margin="8,0,0,0"
                            Visibility="Collapsed"
                            Click="RestorePartitions_Click">
                        <Button.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="Restore Partitions" FontWeight="SemiBold" />
                                    <TextBlock Text="Show the partitions panel again." Foreground="{DynamicResource MutedBrush}" />
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8A7;" Margin="0" />
                    </Button>
                    <Button x:Name="ShowInspectorButton"
                            Style="{StaticResource SecondaryButton}"
                            Width="34"
                            MinWidth="34"
                            Height="30"
                            MinHeight="30"
                            Padding="0"
                            Margin="8,0,0,0"
                            Visibility="Collapsed"
                            Click="RestoreInspector_Click">
                        <Button.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="Restore Inspector" FontWeight="SemiBold" />
                                    <TextBlock Text="Show the inspector panel again." Foreground="{DynamicResource MutedBrush}" />
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE946;" Margin="0" />
                    </Button>
                    <Button x:Name="ClusterViewerToggleButton"
                            Style="{StaticResource SecondaryButton}"
                            MinWidth="98"
                            Height="30"
                            MinHeight="30"
                            Padding="10,0"
                            Margin="8,0,0,0"
                            Visibility="Collapsed"
                            Click="ToggleClusterViewer_Click">
                        <Button.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="Cluster Viewer" FontWeight="SemiBold" />
                                    <TextBlock Text="Switch between the filesystem browser and cluster map view." Foreground="{DynamicResource MutedBrush}" />
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE9D2;" />
                            <TextBlock x:Name="ClusterViewerToggleText" Text="Cluster Viewer" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ToggleResultsWindowButton"
                            Style="{StaticResource SecondaryButton}"
                            MinWidth="86"
                            Height="30"
                            MinHeight="30"
                            Padding="10,0"
                            Margin="6,0,0,0"
                            Visibility="Collapsed"
                            Click="ToggleResultsWindow_Click">
                        <Button.ToolTip>
                            <ToolTip>
                                <StackPanel MaxWidth="260">
                                    <TextBlock Text="Pop Out Results" FontWeight="SemiBold" />
                                    <TextBlock Text="Move Recovery View and Carved Files into a resizable window."
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE8A7;" />
                            <TextBlock x:Name="ToggleResultsWindowText" Text="Pop Out Results" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Grid Grid.Column="3" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource InputBgBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Height="40">
                        <Border.ToolTip>
                            <ToolTip MaxWidth="360">
                                <TextBlock Text="Searches visible filesystem, recovery results, and carved file result names. Press Enter or Find."
                                           TextWrapping="Wrap" />
                            </ToolTip>
                        </Border.ToolTip>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock x:Name="SearchPlaceholder"
                                       Grid.Column="1"
                                       Text="Search file results"
                                       Foreground="{DynamicResource DisabledTextBrush}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                            <TextBox x:Name="SearchBox"
                                     Grid.Column="1"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     VerticalContentAlignment="Center"
                                     TextChanged="SearchBox_TextChanged"
                                     KeyDown="SearchBox_KeyDown" />
                        </Grid>
                    </Border>
                    <Button Grid.Column="1"
                            Style="{StaticResource PrimaryButton}"
                            Content="Find"
                            MinWidth="72"
                            Width="72"
                            Margin="10,0,0,0"
                            ToolTip="Find the first matching file or result name."
                            Click="Search_Click" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PartitionsColumn" Width="280" MinWidth="0" />
                <ColumnDefinition x:Name="PartitionsSplitterColumn" Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorSplitterColumn" Width="6" />
                <ColumnDefinition x:Name="InspectorColumn" Width="320" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <Border x:Name="PartitionsPanel"
                    Grid.Column="0"
                    Background="{DynamicResource PanelBgBrush}"
                    BorderBrush="{DynamicResource LineSoftBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Border Width="3" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" CornerRadius="6,0,0,6" />
                    <Grid Margin="16,16,12,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="PARTITIONS" VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="&#xE921;"
                                    FontFamily="Segoe MDL2 Assets"
                                    Width="28"
                                    MinWidth="28"
                                    MinHeight="28"
                                    Padding="0"
                                    Margin="0,0,6,0"
                                    ToolTip="Minimize partitions"
                                    Click="MinimizePartitions_Click" />
                            <Button Grid.Column="2"
                                    Content="&#xE711;"
                                    FontFamily="Segoe MDL2 Assets"
                                    Width="28"
                                    MinWidth="28"
                                    MinHeight="28"
                                    Padding="0"
                                    ToolTip="Close partitions"
                                    Click="ClosePartitions_Click" />
                        </Grid>
                        <ListBox x:Name="PartitionList"
                                 Grid.Row="1"
                                 ItemsSource="{Binding Partitions}"
                                 SelectedItem="{Binding SelectedPartition}"
                                 PreviewMouseRightButtonDown="PartitionList_PreviewMouseRightButtonDown"
                                 ContextMenuOpening="PartitionList_ContextMenuOpening"
                                 SelectionChanged="PartitionList_SelectionChanged">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Metadata Scan" Click="PartitionMetadataScan_Click" IsEnabled="{Binding CanRunMetadataScan}" />
                                    <MenuItem Header="File Carver" Click="PartitionFileCarver_Click" IsEnabled="{Binding CanRunFileCarver}" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10"
                                            Background="{DynamicResource PanelBg2Brush}"
                                            BorderBrush="{DynamicResource LineSoftBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="15"
                                                       VerticalAlignment="Top" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding OffsetText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,5,0,0" />
                                                <TextBlock Text="{Binding StatusDisplay}"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           FontSize="12"
                                                           LineHeight="16"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Status}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="PartitionsRail"
                    Grid.Column="0"
                    Background="{DynamicResource PanelBgBrush}"
                    BorderBrush="{DynamicResource LineSoftBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="Collapsed">
                <Button Width="42"
                        MinWidth="42"
                        MinHeight="96"
                        Padding="0"
                        ToolTip="Restore partitions"
                        Click="RestorePartitions_Click">
                    <StackPanel>
                        <TextBlock Text="&#xE8A7;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="Partitions"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
            </Border>

            <GridSplitter x:Name="PartitionsSplitter"
                          Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="True"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="FileExplorerPanel"
                        Background="{DynamicResource PanelBgBrush}"
                        BorderBrush="{DynamicResource LineSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="318" MinWidth="220" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="{DynamicResource TreeBgBrush}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="64" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Background="{DynamicResource DataGridHeaderBgBrush}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1" CornerRadius="6,6,0,0">
                                        <Grid Margin="16,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE8B7;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding CurrentFileSystemTitle}"
                                                       Style="{StaticResource SectionLabel}"
                                                       Foreground="{DynamicResource SectionTextBrush}" />
                                            <TextBlock Text="{Binding CurrentDirectorySummary}"
                                                       Grid.Row="1"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       FontSize="12"
                                                       Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding CurrentDirectorySummary}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                                <TreeView x:Name="DirectoryTree"
                                          Grid.Row="1"
                                          BorderThickness="0"
                                          ContextMenuOpening="DirectoryTree_ContextMenuOpening"
                                          PreviewMouseRightButtonDown="DirectoryTree_PreviewMouseRightButtonDown"
                                          SelectedItemChanged="DirectoryTree_SelectedItemChanged">
                                    <TreeView.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Save Folder..." Click="SaveDirectoryTreeSelection_Click" />
                                        </ContextMenu>
                                    </TreeView.ContextMenu>
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="{Binding Glyph}"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="12"
                                                           Foreground="{Binding GlyphColor}"
                                                           Margin="0,0,8,0"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{DynamicResource TreeItemTextBrush}"
                                                           FontSize="13"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Column="1"
                                      Width="6"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Background="Transparent"
                                      ShowsPreview="True"
                                      ResizeBehavior="PreviousAndNext"
                                      ResizeDirection="Columns" />

                        <Border Grid.Column="2" Background="{DynamicResource DataGridRowBgBrush}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Background="{DynamicResource DataGridHeaderBgBrush}"
                                        BorderBrush="{DynamicResource LineSoftBrush}"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="6,6,0,0"
                                        Padding="12,8">
                                    <Grid>
                                        <TextBlock Text="{Binding CurrentDirectorySummary}"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,36,0"
                                                   VerticalAlignment="Center" />
                                        <Border HorizontalAlignment="Right"
                                                Width="24"
                                                Height="24"
                                                CornerRadius="12"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                BorderBrush="{DynamicResource AccentBrush}"
                                                BorderThickness="1"
                                                Cursor="Help">
                                            <Border.ToolTip>
                                                <ToolTip>
                                                    <StackPanel MinWidth="250">
                                                        <TextBlock Text="Row colors" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                            <Border Width="16" Height="16" CornerRadius="3" Background="{DynamicResource StatusContiguousBgBrush}" BorderBrush="#6CFFB0" BorderThickness="1.5" Margin="0,0,8,0">
                                                                <Border.Effect>
                                                                    <DropShadowEffect Color="#38D47B" BlurRadius="10" ShadowDepth="0" Opacity="0.8" />
                                                                </Border.Effect>
                                                            </Border>
                                                            <TextBlock Text="Contiguous" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                            <Border Width="16" Height="16" CornerRadius="3" Background="{DynamicResource StatusFragmentedBgBrush}" BorderBrush="#FFD166" BorderThickness="1.5" Margin="0,0,8,0">
                                                                <Border.Effect>
                                                                    <DropShadowEffect Color="#F5B84B" BlurRadius="10" ShadowDepth="0" Opacity="0.82" />
                                                                </Border.Effect>
                                                            </Border>
                                                            <TextBlock Text="Fragmented / collisions" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                            <Border Width="16" Height="16" CornerRadius="3" Background="{DynamicResource StatusFullyFragmentedBgBrush}" BorderBrush="#FF8C6A" BorderThickness="1.5" Margin="0,0,8,0">
                                                                <Border.Effect>
                                                                    <DropShadowEffect Color="#FF704F" BlurRadius="10" ShadowDepth="0" Opacity="0.85" />
                                                                </Border.Effect>
                                                            </Border>
                                                            <TextBlock Text="Fully fragmented / overwritten" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                            <Border Width="16" Height="16" CornerRadius="3" Background="{DynamicResource StatusEmptyBgBrush}" BorderBrush="#7FB2FF" BorderThickness="1.5" Margin="0,0,8,0">
                                                                <Border.Effect>
                                                                    <DropShadowEffect Color="#5EA1FF" BlurRadius="10" ShadowDepth="0" Opacity="0.82" />
                                                                </Border.Effect>
                                                            </Border>
                                                            <TextBlock Text="Empty / sparse / resident" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="16" Height="16" CornerRadius="3" Background="{DynamicResource StatusUnrecoverableBgBrush}" BorderBrush="#FF6B81" BorderThickness="1.5" Margin="0,0,8,0">
                                                                <Border.Effect>
                                                                    <DropShadowEffect Color="#FF5D73" BlurRadius="10" ShadowDepth="0" Opacity="0.86" />
                                                                </Border.Effect>
                                                            </Border>
                                                            <TextBlock Text="Deleted / orphan inode / unrecoverable" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </ToolTip>
                                            </Border.ToolTip>
                                            <TextBlock Text="?"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <DataGrid x:Name="FilesGrid"
                                      Grid.Row="1"
                                      ItemsSource="{Binding Files}"
                                      SelectedItem="{Binding SelectedFile}"
                                      SelectionMode="Extended"
                                      RowStyle="{StaticResource DirectoryDataGridRow}"
                                      ContextMenuOpening="FileGrid_ContextMenuOpening"
                                      PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown"
                                      MouseDoubleClick="FilesGrid_MouseDoubleClick"
                                      SelectionChanged="FilesGrid_SelectionChanged">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Save Selected..." Click="SaveFileGridSelection_Click" />
                                        <Separator />
                                        <MenuItem Header="Copy Offset" Click="CopyFileGridOffset_Click" />
                                        <MenuItem Header="Copy First Cluster" Click="CopyFileGridFirstCluster_Click" />
                                        <MenuItem Header="Copy Address Details" Click="CopyFileGridAddressDetails_Click" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Name" SortMemberPath="Name" Width="240" MinWidth="170" CanUserResize="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding KindGlyph}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               Foreground="{Binding KindColor}"
                                                               Margin="0,0,10,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" SortMemberPath="KindSort" Width="104" MinWidth="92" CanUserResize="True" />
                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="SizeBytes" Width="132" MinWidth="104" CanUserResize="True" />
                                    <DataGridTextColumn Header="Created" Binding="{Binding CreatedText}" SortMemberPath="Created" Width="174" MinWidth="150" CanUserResize="True" />
                                    <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedText}" SortMemberPath="Modified" Width="174" MinWidth="150" CanUserResize="True" />
                                    <DataGridTextColumn Header="Offset" Binding="{Binding OffsetText}" SortMemberPath="Offset" Width="144" MinWidth="124" CanUserResize="True" />
                                    <DataGridTextColumn Header="Cluster" Binding="{Binding ClusterText}" SortMemberPath="ClusterNumber" Width="110" MinWidth="92" CanUserResize="True" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding DisplayStatusText}" SortMemberPath="DisplayStatusSort" Width="210" MinWidth="150" CanUserResize="True" />
                                    <DataGridTextColumn Header="Runs" Binding="{Binding FragmentRunText}" SortMemberPath="FragmentRunCount" Width="74" MinWidth="62" CanUserResize="True" />
                                    <DataGridTextColumn Header="Collisions" Binding="{Binding CollisionText}" SortMemberPath="CollisionCount" Width="98" MinWidth="82" CanUserResize="True" />
                                </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="ClusterViewerPanel"
                        Grid.Row="0"
                        Background="{DynamicResource PanelBgBrush}"
                        BorderBrush="{DynamicResource LineSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="Collapsed">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="64" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Background="{DynamicResource DataGridHeaderBgBrush}"
                                BorderBrush="{DynamicResource LineSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="6,6,0,0">
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE9D2;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="CLUSTER VIEWER"
                                               Style="{StaticResource SectionLabel}"
                                               Foreground="{DynamicResource SectionTextBrush}" />
                                    <TextBlock Text="{Binding ClusterViewerSummary}"
                                               Grid.Row="1"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontSize="12"
                                               Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <Button Grid.Column="2"
                                        Content="&#xE921;"
                                        FontFamily="Segoe MDL2 Assets"
                                        Width="28"
                                        MinWidth="28"
                                        MinHeight="28"
                                        Padding="0"
                                        ToolTip="Return to filesystem browser"
                                        Click="ToggleClusterViewer_Click" />
                            </Grid>
                        </Border>

                        <DataGrid x:Name="ClusterMapGrid"
                                  Grid.Row="1"
                                  ItemsSource="{Binding ClusterMapRows}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeRows="False"
                                  CanUserSortColumns="False"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="False"
                                  HeadersVisibility="Column"
                                  IsReadOnly="True"
                                  ColumnHeaderHeight="24"
                                  RowHeaderWidth="0"
                                  RowHeight="26"
                                  SelectionMode="Single"
                                  SelectionUnit="Cell"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  Background="{DynamicResource DataGridRowBgBrush}"
                                  BorderBrush="{DynamicResource LineSoftBrush}"
                                  BorderThickness="1">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{DynamicResource DataGridHeaderBgBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource DataGridHeaderTextBrush}" />
                                    <Setter Property="FontFamily" Value="Consolas" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource LineSoftBrush}" />
                                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridColumnHeader">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="{DynamicResource DataGridRowBgBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource LineSoftBrush}" />
                                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#"
                                                    Binding="{Binding RowNumber}"
                                                    Width="56"
                                                    MinWidth="56"
                                                    CanUserResize="False"
                                                    CanUserSort="False">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="Consolas" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Offset"
                                                    Binding="{Binding OffsetText}"
                                                    Width="150"
                                                    MinWidth="150"
                                                    CanUserResize="False"
                                                    CanUserSort="False">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="Consolas" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Margin" Value="8,0,0,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border x:Name="ResultsPanel"
                        Grid.Row="2"
                        Background="{DynamicResource PanelBgBrush}"
                        BorderBrush="{DynamicResource LineSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid Margin="12,8,12,12">
                        <TabControl x:Name="ResultsTabs"
                                    SelectedIndex="2"
                                    PreviewMouseLeftButtonDown="ResultsTabs_PreviewMouseLeftButtonDown"
                                    PreviewMouseLeftButtonUp="ResultsTabs_PreviewMouseLeftButtonUp"
                                    PreviewMouseMove="ResultsTabs_PreviewMouseMove">
                        <TabItem x:Name="RecoveryTab" Header="Recovery View">
                            <Border Background="{DynamicResource DataGridRowBgBrush}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1" CornerRadius="0,6,6,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="300" MinWidth="220" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TreeView x:Name="RecoveryTree"
                                              ItemsSource="{Binding RecoveryTreeRoots}"
                                              BorderThickness="0"
                                              SelectedItemChanged="RecoveryTree_SelectedItemChanged">
                                        <TreeView.ItemTemplate>
                                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <TextBlock Text="{Binding Glyph}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               Foreground="{Binding GlyphColor}"
                                                               Margin="0,0,8,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="{DynamicResource TreeItemTextBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </HierarchicalDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>
                                    <GridSplitter Grid.Column="1"
                                                  Width="6"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  Background="Transparent"
                                                  ShowsPreview="True"
                                                  ResizeBehavior="PreviousAndNext"
                                                  ResizeDirection="Columns" />
                                    <DataGrid x:Name="RecoveryGrid"
                                              Grid.Column="2"
                                              ItemsSource="{Binding RecoveryRows}"
                                              SelectedItem="{Binding SelectedRecoveryFile}"
                                              RowStyle="{StaticResource DirectoryDataGridRow}"
                                              SelectionMode="Extended"
                                              ContextMenuOpening="RecoveryGrid_ContextMenuOpening"
                                              PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown"
                                              MouseDoubleClick="RecoveryGrid_MouseDoubleClick"
                                              SelectionChanged="RecoveryGrid_SelectionChanged">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Save Selected..." Click="SaveRecoveryGridSelection_Click" />
                                                <Separator />
                                                <MenuItem Header="Copy Offset" Click="CopyRecoveryGridOffset_Click" />
                                                <MenuItem Header="Copy First Cluster" Click="CopyRecoveryGridFirstCluster_Click" />
                                                <MenuItem Header="Copy Address Details" Click="CopyRecoveryGridAddressDetails_Click" />
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Name" SortMemberPath="Name" Width="230" MinWidth="160" CanUserResize="True">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding KindGlyph}"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       Foreground="{Binding KindColor}"
                                                                       Margin="0,0,10,0"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" SortMemberPath="KindSort" Width="90" MinWidth="76" CanUserResize="True" />
                                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="SizeBytes" Width="112" MinWidth="92" CanUserResize="True" />
                                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedText}" SortMemberPath="Created" Width="155" MinWidth="132" CanUserResize="True" />
                                            <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedText}" SortMemberPath="Modified" Width="155" MinWidth="132" CanUserResize="True" />
                                            <DataGridTextColumn Header="Offset" Binding="{Binding OffsetText}" SortMemberPath="Offset" Width="130" MinWidth="112" CanUserResize="True" />
                                            <DataGridTextColumn Header="Cluster" Binding="{Binding ClusterText}" SortMemberPath="ClusterNumber" Width="92" MinWidth="78" CanUserResize="True" />
                                            <DataGridTextColumn Header="Score" Binding="{Binding ScoreText}" SortMemberPath="Score" Width="74" MinWidth="62" CanUserResize="True" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" SortMemberPath="Status" Width="260" MinWidth="160" CanUserResize="True" />
                                            <DataGridTextColumn Header="Runs" Binding="{Binding FragmentRunText}" SortMemberPath="FragmentRunCount" Width="74" MinWidth="62" CanUserResize="True" />
                                            <DataGridTextColumn Header="Largest Run" Binding="{Binding LargestRunText}" SortMemberPath="LargestRunLength" Width="112" MinWidth="94" CanUserResize="True" />
                                            <DataGridTextColumn Header="Collisions" Binding="{Binding CollisionText}" SortMemberPath="CollisionCount" Width="98" MinWidth="82" CanUserResize="True" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </TabItem>
                        <TabItem x:Name="CarverTab" Header="Carved Files">
                            <Border Background="{DynamicResource DataGridRowBgBrush}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1" CornerRadius="0,6,6,6">
                                <DataGrid x:Name="CarverGrid"
                                          ItemsSource="{Binding CarvedFiles}"
                                          SelectedItem="{Binding SelectedCarvedFile}"
                                          SelectionMode="Extended"
                                          ContextMenuOpening="CarverGrid_ContextMenuOpening"
                                          PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown"
                                          SelectionChanged="CarverGrid_SelectionChanged">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Save Selected..." Click="SaveCarverGridSelection_Click" />
                                            <Separator />
                                            <MenuItem Header="Copy Offset" Click="CopyCarverGridOffset_Click" />
                                            <MenuItem Header="Copy Relative Offset" Click="CopyCarverGridRelativeOffset_Click" />
                                            <MenuItem Header="Copy Address Details" Click="CopyCarverGridAddressDetails_Click" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" SortMemberPath="Name" Width="250" MinWidth="170" CanUserResize="True" />
                                        <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" SortMemberPath="Kind" Width="96" MinWidth="80" CanUserResize="True" />
                                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="SizeBytes" Width="120" MinWidth="92" CanUserResize="True" />
                                        <DataGridTextColumn Header="Offset" Binding="{Binding OffsetText}" SortMemberPath="Offset" Width="160" MinWidth="135" CanUserResize="True" />
                                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" SortMemberPath="Source" Width="180" MinWidth="130" CanUserResize="True" />
                                        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" SortMemberPath="Detail" Width="320" MinWidth="180" CanUserResize="True" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </TabItem>
                        <TabItem x:Name="LogTab" Header="Log">
                            <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1" CornerRadius="0,6,6,6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Background="{DynamicResource PanelBg2Brush}"
                                            BorderBrush="{DynamicResource LineSoftBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="12,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsScanProgressVisible}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ItemsControl ItemsSource="{Binding ScanProgressRows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Text}"
                                                                       Foreground="{DynamicResource MutedBrush}"
                                                                       VerticalAlignment="Center" />
                                                            <ProgressBar Grid.Row="1"
                                                                         Grid.ColumnSpan="2"
                                                                         Height="10"
                                                                         Margin="0,8,0,0"
                                                                         Minimum="0"
                                                                         Maximum="100"
                                                                         Value="{Binding Value, Mode=OneWay}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <StackPanel Grid.Column="1"
                                                        Margin="12,0,0,8"
                                                        VerticalAlignment="Top">
                                                <Button Click="CancelScan_Click"
                                                        IsEnabled="{Binding CanCancelScan}"
                                                        ToolTip="Cancel current metadata or file-carver scan">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanCancelScan}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE711;" />
                                                        <TextBlock Text="Cancel Scan" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Margin="0,8,0,0"
                                                        Click="CancelExport_Click"
                                                        IsEnabled="{Binding CanCancelExport}"
                                                        ToolTip="Cancel current export">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanCancelExport}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE711;" />
                                                        <TextBlock Text="Cancel Export" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <TextBox x:Name="LogTextBox"
                                             Grid.Row="1"
                                             Text="{Binding LogText}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" />
                                </Grid>
                            </Border>
                        </TabItem>
                        </TabControl>
                        <Button x:Name="ResultsPanelDetachButton"
                                Style="{StaticResource SecondaryButton}"
                                Panel.ZIndex="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Height="28"
                                MinHeight="28"
                                MinWidth="96"
                                Padding="10,0"
                                Margin="0,1,4,0"
                                Click="ToggleResultsWindow_Click">
                            <Button.ToolTip>
                                <ToolTip Placement="Left" MaxWidth="280">
                                    <StackPanel MaxWidth="260">
                                        <TextBlock Text="Pop Out Results" FontWeight="SemiBold" />
                                        <TextBlock Text="Move Recovery View and Carved Files into a resizable window."
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </ToolTip>
                            </Button.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE8A7;" />
                                <TextBlock x:Name="ResultsPanelDetachText" Text="Pop Out" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter x:Name="InspectorSplitter"
                          Grid.Column="3"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="True"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns" />

            <Border x:Name="InspectorPanel"
                    Grid.Column="4"
                    Background="{DynamicResource PanelBgBrush}"
                    BorderBrush="{DynamicResource LineSoftBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="INSPECTOR" VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="&#xE921;"
                                FontFamily="Segoe MDL2 Assets"
                                Width="28"
                                MinWidth="28"
                                MinHeight="28"
                                Padding="0"
                                Margin="0,0,6,0"
                                ToolTip="Minimize inspector"
                                Click="MinimizeInspector_Click" />
                        <Button Grid.Column="2"
                                Content="&#xE711;"
                                FontFamily="Segoe MDL2 Assets"
                                Width="28"
                                MinWidth="28"
                                MinHeight="28"
                                Padding="0"
                                ToolTip="Close inspector"
                                Click="CloseInspector_Click" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="230">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InspectorRows.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="54" Height="54" CornerRadius="16" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center" Margin="0,0,0,14">
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="24"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding InspectorTitle}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding InspectorSubtitle}" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>

                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InspectorRows.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="{Binding InspectorTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding InspectorSubtitle}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
                            </StackPanel>

                            <Border Grid.Row="1"
                                    Background="{DynamicResource PanelBg2Brush}"
                                    BorderBrush="{DynamicResource LineSoftBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8"
                                    Margin="0,0,0,12">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInspectorPreviewVisible}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Image Source="{Binding InspectorPreviewImage}"
                                       Stretch="Uniform"
                                       MaxHeight="210"
                                       SnapsToDevicePixels="True" />
                            </Border>

                            <ItemsControl Grid.Row="2" ItemsSource="{Binding InspectorRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource PanelBg2Brush}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1" CornerRadius="6" Padding="11" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="128" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Label}"
                                                           Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Value}"
                                                           TextWrapping="Wrap"
                                                           ToolTip="{Binding Value}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="InspectorRail"
                    Grid.Column="4"
                    Background="{DynamicResource PanelBgBrush}"
                    BorderBrush="{DynamicResource LineSoftBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="Collapsed">
                <Button Width="42"
                        MinWidth="42"
                        MinHeight="96"
                        Padding="0"
                        ToolTip="Restore inspector"
                        Click="RestoreInspector_Click">
                    <StackPanel>
                        <TextBlock Text="&#xE946;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="Inspector"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Background="{DynamicResource ToolbarBgBrush}"
                BorderBrush="{DynamicResource LineSoftBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="190" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,9,0" />
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <ProgressBar Grid.Column="1"
                             Height="12"
                             IsIndeterminate="{Binding IsBusy}"
                             VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
