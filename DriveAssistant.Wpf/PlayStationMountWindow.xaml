<Window x:Class="FATXTools.Wpf.PlayStationMountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open PlayStation HDD"
        Width="980"
        Height="680"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Border Background="{DynamicResource AppBgBrush}" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Open PlayStation HDD" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Mount encrypted PS3/PS4 HDD images through the bundled native bridge using the required console key file."
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <Border Grid.Row="1"
                    Background="{DynamicResource PanelBgBrush}"
                    BorderBrush="{DynamicResource LineSoftBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="132" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="112" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="HDD image" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    <TextBox x:Name="ImagePathTextBox" Grid.Column="1" Margin="0,0,10,0" />
                    <Button Grid.Column="2" Content="Browse" MinWidth="100" Click="BrowseImage_Click" />

                    <TextBlock Grid.Row="2" Text="Key file" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    <TextBox x:Name="KeyPathTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,10,0" />
                    <Button Grid.Row="2" Grid.Column="2" Content="Browse" MinWidth="100" Click="BrowseKey_Click" />

                    <TextBlock Grid.Row="4" Text="Fallback tool" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    <TextBox x:Name="MountToolPathTextBox" Grid.Row="4" Grid.Column="1" Margin="0,0,10,0" />
                    <Button Grid.Row="4" Grid.Column="2" Content="Browse" MinWidth="100" Click="BrowseMountTool_Click" />

                    <TextBlock Grid.Row="6"
                               Grid.Column="1"
                               Grid.ColumnSpan="2"
                               Text="PS3 requires an EID root key. PS4 requires an EAP HDD key. mount-tool.exe is only used if the native bridge DLL cannot load."
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330" MinWidth="260" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.ColumnSpan="3" Margin="0,0,0,10">
                    <Button Content="List Partitions" Style="{StaticResource PrimaryButton}" Click="ListPartitions_Click" />
                    <Button Content="Mount Selected" Margin="10,0,0,0" Click="MountSelected_Click" />
                    <Button Content="Recover Files" Margin="10,0,0,0" Click="RecoverFiles_Click" />
                    <Button Content="Export File" Margin="10,0,0,0" Click="ExportFile_Click" />
                    <Button Content="Export Decrypted" Margin="10,0,0,0" Click="ExportPartition_Click" />
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"
                               TextTrimming="CharacterEllipsis" />
                </WrapPanel>

                <Grid Grid.Row="1"
                      Grid.ColumnSpan="3"
                      Margin="0,0,0,10">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBridgeProgressVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding BridgeProgressText}"
                               Foreground="{DynamicResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar Grid.Row="2"
                                 Height="8"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding BridgeProgressValue}"
                                 IsIndeterminate="{Binding IsBridgeProgressIndeterminate}" />
                </Grid>

                <Border Grid.Row="2"
                        Background="{DynamicResource PanelBgBrush}"
                        BorderBrush="{DynamicResource LineSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <DataGrid x:Name="PartitionsGrid"
                              ItemsSource="{Binding Partitions}"
                              SelectedItem="{Binding SelectedPartition}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              MouseDoubleClick="PartitionsGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Partition" Binding="{Binding Name}" Width="145" MinWidth="120" />
                            <DataGridTextColumn Header="Start" Binding="{Binding StartText}" Width="88" MinWidth="80" />
                            <DataGridTextColumn Header="Length" Binding="{Binding LengthText}" Width="88" MinWidth="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <GridSplitter Grid.Row="2"
                              Grid.Column="1"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="Transparent"
                              ShowsPreview="True" />

                <Border Grid.Row="2"
                        Grid.Column="2"
                        Background="{DynamicResource PanelBgBrush}"
                        BorderBrush="{DynamicResource LineSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10">
                    <TabControl>
                        <TabItem Header="File System">
                            <TreeView ItemsSource="{Binding RootNodes}" BorderThickness="0">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="{Binding Glyph}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{Binding GlyphColor}"
                                                       Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" />
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </TabItem>

                        <TabItem Header="Native Files">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Background="{DynamicResource DataGridHeaderBgBrush}"
                                        BorderBrush="{DynamicResource LineSoftBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="12,8">
                                    <WrapPanel VerticalAlignment="Center">
                                        <TextBlock Text="Recovery colors"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,12,0"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                            <Border Width="12" Height="12" CornerRadius="2" Background="{DynamicResource StatusContiguousBgBrush}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1" Margin="0,0,5,0" />
                                            <TextBlock Text="Contiguous" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                            <Border Width="12" Height="12" CornerRadius="2" Background="{DynamicResource StatusFragmentedBgBrush}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1" Margin="0,0,5,0" />
                                            <TextBlock Text="Fragmented" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                            <Border Width="12" Height="12" CornerRadius="2" Background="{DynamicResource StatusFullyFragmentedBgBrush}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1" Margin="0,0,5,0" />
                                            <TextBlock Text="Fully fragmented" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                            <Border Width="12" Height="12" CornerRadius="2" Background="{DynamicResource StatusUnrecoverableBgBrush}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1" Margin="0,0,5,0" />
                                            <TextBlock Text="Unrecoverable" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="12" Height="12" CornerRadius="2" Background="{DynamicResource StatusEmptyBgBrush}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1" Margin="0,0,5,0" />
                                            <TextBlock Text="Empty" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </WrapPanel>
                                </Border>
                                <DataGrid ItemsSource="{Binding FileRows}"
                                      Grid.Row="1"
                                      SelectedItem="{Binding SelectedFile}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="{DynamicResource DataGridRowBgBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                        <Setter Property="ToolTip" Value="{Binding FragmentationTooltip}" />
                                        <Style.Triggers>
                                            <Trigger Property="AlternationIndex" Value="1">
                                                <Setter Property="Background" Value="{DynamicResource DataGridAltRowBgBrush}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding FragmentationStatus}" Value="Contiguous">
                                                <Setter Property="Background" Value="{DynamicResource StatusContiguousBgBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FragmentationStatus}" Value="Fragmented">
                                                <Setter Property="Background" Value="{DynamicResource StatusFragmentedBgBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FragmentationStatus}" Value="Fully fragmented">
                                                <Setter Property="Background" Value="{DynamicResource StatusFullyFragmentedBgBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RecoveryDisplayStatus}" Value="Unrecoverable">
                                                <Setter Property="Background" Value="{DynamicResource StatusUnrecoverableBgBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RecoveryDisplayStatus}" Value="Empty">
                                                <Setter Property="Background" Value="{DynamicResource StatusEmptyBgBrush}" />
                                            </DataTrigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Recovery" Binding="{Binding RecoveryDisplayStatus}" Width="125" MinWidth="110" />
                                    <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="2*" MinWidth="220" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90" MinWidth="75" />
                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="110" MinWidth="95" />
                                    <DataGridTextColumn Header="Offsets" Binding="{Binding OffsetCountText}" Width="85" MinWidth="75" />
                                    <DataGridTextColumn Header="Runs" Binding="{Binding RunsText}" Width="75" MinWidth="65" />
                                    <DataGridTextColumn Header="Largest Run" Binding="{Binding LargestRunText}" Width="115" MinWidth="100" />
                                    <DataGridTextColumn Header="Modified" Binding="{Binding Modified}" Width="145" MinWidth="120" />
                                    <DataGridTextColumn Header="Data Ranges" Binding="{Binding DataRanges}" Width="2*" MinWidth="220" />
                                </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Close" Width="94" Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
