<Window x:Class="FATXTools.Wpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Settings"
        Width="720"
        Height="780"
        MinWidth="580"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="None">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="30"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid Background="{DynamicResource AppBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource TitleBarBgBrush}"
                BorderBrush="{DynamicResource LineSoftBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Image Source="appicon.ico" Width="16" Height="16" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{DynamicResource TitleBarTextBrush}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="&#xE921;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Foreground="{DynamicResource TitleBarTextBrush}"
                        MinWidth="46"
                        MinHeight="30"
                        Padding="0"
                        BorderThickness="0"
                        ToolTip="Minimize"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MinimizeWindow_Click" />
                <Button Grid.Column="2"
                        Content="&#xE922;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Foreground="{DynamicResource TitleBarTextBrush}"
                        MinWidth="46"
                        MinHeight="30"
                        Padding="0"
                        BorderThickness="0"
                        ToolTip="Maximize"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MaximizeRestoreWindow_Click" />
                <Button Grid.Column="3"
                        Content="&#xE8BB;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Foreground="{DynamicResource TitleBarTextBrush}"
                        MinWidth="46"
                        MinHeight="30"
                        Padding="0"
                        BorderThickness="0"
                        ToolTip="Close"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CloseWindow_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource AppBgBrush}" Padding="20,18,20,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Configure scan intervals, parallel workers, logging, and custom carving signatures."
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
            <Border
                    Background="{DynamicResource PanelBgBrush}"
                    BorderBrush="{DynamicResource LineSoftBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="166" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="116" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Scan profile" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    <ComboBox x:Name="ScanProfileCombo" Grid.Column="1" Grid.ColumnSpan="2" MinHeight="34">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Text="File carver interval" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    <ComboBox x:Name="FileCarverIntervalCombo" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" MinHeight="34">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" Foreground="{DynamicResource MutedBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="4" Text="Metadata interval clusters" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    <TextBox x:Name="MetadataIntervalTextBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" />

                    <TextBlock Grid.Row="6" Text="Log to file" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    <CheckBox x:Name="EnableFileLoggingCheckBox" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Left" />

                    <TextBlock Grid.Row="8" Text="Log file" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    <TextBox x:Name="LogFileTextBox" Grid.Row="8" Grid.Column="1" Margin="0,0,10,0" />
                    <Button Grid.Row="8" Grid.Column="2" Content="Browse" MinWidth="104" Click="BrowseLog_Click" />

                    <TextBlock Grid.Row="10" Text="Custom carvers file" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    <TextBox x:Name="CustomCarversTextBox" Grid.Row="10" Grid.Column="1" Margin="0,0,10,0" />
                    <Button Grid.Row="10" Grid.Column="2" Content="Browse" MinWidth="104" Click="BrowseCustomCarvers_Click" />

                    <TextBlock Grid.Row="12" Text="Metadata scan workers" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    <ComboBox x:Name="MetadataWorkersCombo" Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2" MinHeight="34">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="14" Text="Theme" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    <ComboBox x:Name="ThemeCombo" Grid.Row="14" Grid.Column="1" Grid.ColumnSpan="2" MinHeight="34" />
                </Grid>
            </Border>

            <Border Background="{DynamicResource PanelBgBrush}"
                    BorderBrush="{DynamicResource LineSoftBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14"
                    Margin="0,14,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Keyboard shortcuts" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Click a shortcut cell and press a key combination. Backspace or Delete clears it."
                                   Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Restore Defaults"
                            MinWidth="132"
                            VerticalAlignment="Top"
                            Click="RestoreDefaultShortcuts_Click" />

                    <DataGrid x:Name="ShortcutGrid"
                              Grid.Row="2"
                              Grid.ColumnSpan="2"
                              Margin="0,14,0,0"
                              Height="285"
                              RowHeight="38"
                              ItemsSource="{Binding ShortcutRows, RelativeSource={RelativeSource AncestorType=Window}}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Group" Binding="{Binding Category}" Width="110" IsReadOnly="True" />
                            <DataGridTextColumn Header="Action" Binding="{Binding Name}" Width="*" MinWidth="190" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Shortcut" Width="210" MinWidth="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Gesture, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="30"
                                                 MinHeight="30"
                                                 Padding="8,3"
                                                 VerticalAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 PreviewKeyDown="ShortcutTextBox_PreviewKeyDown"
                                                 ToolTip="Press a shortcut, type one manually, or use Backspace/Delete to clear." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Width="92" Click="Cancel_Click" />
                <Button Content="Save" Width="92" Margin="10,0,0,0" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
            </StackPanel>
        </Grid>
        </Border>
    </Grid>
</Window>
